# Local Python environment and bytecode
.venv/
__pycache__/
*.py[cod]

# Test and analysis caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# Real configuration and credentials
.env
.env.*
!.env.example
as-stat-web.conf

# Persistent runtime metadata, locks, temporary files and diagnostic backups
data/asn-metadata.json*
data/asn-metadata.lock
data/.asn-metadata-*

# Logs, process state and temporary verification output
*.log
*.pid
*.pid.lock
*.tmp
*.bak
*.swp
*~
tests/tmp*/
verification-results/

data/web-cache/

.publication/
