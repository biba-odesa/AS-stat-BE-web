[server]
url_prefix =
# Leave empty to serve at the URL root.
# Defaults to loopback; use the VM internal address for manual access.
host = 127.0.0.1
port = 8000

[victoriametrics]
# Server-selected HTTP endpoints; transport always bypasses proxies.
endpoint_1d = 127.0.0.1:8428
endpoint_1w = 127.0.0.1:8429
endpoint_1m = 127.0.0.1:8430
endpoint_1y = 127.0.0.1:8431

[links]
# Relative paths are resolved against the web project root.
knownlinks = /etc/as-stat-be-web/knownlinks

[proxy]
# Optional: uncomment when external RIPEstat access requires the proxy.
# HTTP_PROXY = http://proxy.example.net:3128
# HTTPS_PROXY = http://proxy.example.net:3128
# NO_PROXY = localhost,127.0.0.1,::1

[asn_metadata]
http_timeout_seconds = 10

[svg]
cache_ttl_seconds = 1200

[web_cache]
path = data/web-cache
ttl_seconds = 1200
max_size_bytes = 134217728

[ipv]
# Per VM query, including history discovery and every sequential block.
vm_timeout_seconds = 30
short_cache_ttl_seconds = 3600
long_cache_ttl_seconds = 604800

[top_asn]
# Timeout per VM query; ranking uses two sequential instant queries.
vm_timeout_seconds = 30
